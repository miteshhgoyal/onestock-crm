# =====================================================================
# Onestock Academy CRM - Backend Configuration
# =====================================================================

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For local MongoDB: "mongodb://127.0.0.1:27017"
# For MongoDB Atlas: "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGO_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="crm_onestock"

# Security & Authentication
# Generate a random 64-char hex key using: openssl rand -hex 32
JWT_SECRET="generate-with-openssl-rand-hex-32"

# Master Admin Credentials (auto-seeded on server startup)
ADMIN_EMAIL="admin@onestockacademy.com"
ADMIN_PASSWORD="ChooseAStrongAdminPassword123!"

# CORS Configuration (comma-separated origins)
# For local development: "http://localhost:3000,http://127.0.0.1:3000"
# For production: "https://crm.yourdomain.com"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://crm.yourdomain.com"

# Timezone & Operating Hours
TEAM_TIMEZONE="Asia/Kolkata"

# =====================================================================
# Document Storage Configuration
# Choose one of: "cloudinary", "r2", or "local"
# =====================================================================
STORAGE_TYPE="cloudinary"

# ---------------------------------------------------------------------
# Option A: Cloudinary Storage Configuration
# Set STORAGE_TYPE="cloudinary" to use this backend.
# Obtain these from: Cloudinary Dashboard -> Product Environment Settings -> API Keys
# ---------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Alternatively, you can use the single CLOUDINARY_URL string:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# ---------------------------------------------------------------------
# Option B: Cloudflare R2 Storage Configuration (S3-Compatible)
# Set STORAGE_TYPE="r2" to use this backend.
# Obtain these from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# ---------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="crm-documents"
# Optional endpoint override (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com):
R2_ENDPOINT_URL=""

# ---------------------------------------------------------------------
# Option C: Local Filesystem Storage Configuration
# Set STORAGE_TYPE="local" to use this backend.
# Default on local machines: backend/uploads/documents
# Default on Linux VPS: /var/data/crm_uploads
# ---------------------------------------------------------------------
LOCAL_STORAGE_DIR=""

# =====================================================================
# External Telephony & Webhook Integrations (Optional)
# =====================================================================

# Tata Smartflo Click-to-Call Integration (Optional)
SMARTFLO_API_TOKEN=""
SMARTFLO_CALLER_ID=""
SMARTFLO_WEBHOOK_SECRET=""
SMARTFLO_BASE_URL="https://api-smartflo.tatateleservices.com"

# Lead Intake Webhook Key (Optional - for website lead form)
INTAKE_API_KEY=""

# 50 Cr Club & VIP Market Integrations (Optional)
PAYMENT_WEBHOOK_TOKEN=""
ADMIN_PANEL_KEY=""
VIP_MARKET_ADMIN_URL=""
VIP_MARKET_TIMEOUT_SECONDS="120"

# Background Escalation Cron Secret (Optional - for systemd / linux crontab)
WEBHOOK_CRON_SECRET=""
