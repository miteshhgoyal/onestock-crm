# =====================================================================
# Onestock Academy CRM - Frontend Environment Configuration
# =====================================================================

# In Local Development (Frontend on port 3000, Backend on port 8000):
REACT_APP_BACKEND_URL="http://localhost:8000"

# In Production with Nginx reverse proxy (proxying /api to 127.0.0.1:8000):
# Leave empty so all API requests use relative paths (e.g. /api/...):
# REACT_APP_BACKEND_URL=""
